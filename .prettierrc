{
  "$schema": "https://json.schemastore.org/prettierrc",
  "overrides": [
    {
      "files": ["*.js", "*.ts", "*.json", "*.sh", "*.yml", "*.yaml"],
      "options": {
        "singleQuote": true,
        "arrowParens": "avoid",
        "trailingComma": "all",
        "tabWidth": 2,
        "useTabs": false
      }
    },
    {
      "files": ["**/*.json"],
      "excludeFiles": ["**/tsconfig*.json", "tsconfig*.json"],
      "options": {
        "plugins": ["prettier-plugin-sort-json"]
      }
    }
  ],
  "plugins": ["prettier-plugin-packagejson"]
}
