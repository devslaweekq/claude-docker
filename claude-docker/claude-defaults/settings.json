{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMode": {
    "allow": [
      "$defaults",
      "Allow spawning subagents (Agent) for parallel research and codebase exploration",
      "Allow WebSearch and WebFetch for documentation lookup and web research"
    ],
    "environment": [
      "Local development workspaces and git repositories on this machine",
      "Parallel subagents for research, exploration, and documentation tasks are routine"
    ]
  },
  "editorMode": "normal",
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "devslaweekq@devslaweekq-skills": true,
    "figma@claude-plugins-official": false,
    "pymobiledevice3-device-operator@pymobiledevice3": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "devslaweekq-skills": {
      "source": {
        "repo": "devslaweekq/best-skills",
        "source": "github"
      }
    },
    "pymobiledevice3": {
      "source": {
        "repo": "doronz88/pymobiledevice3",
        "source": "github"
      }
    },
    "thedotmack": {
      "source": {
        "source": "git",
        "url": "https://github.com/thedotmack/claude-mem.git"
      }
    }
  },
  "gitAttribution": true,
  "includeCoAuthoredBy": false,
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Read(**/.env.ci)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account.json)",
      "Bash(rm -rf /)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  },
  "skillOverrides": {
    "video-use": "off"
  },
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "theme": "dark-ansi",
  "timeFormat": "24-hour",
  "verbose": false,
  "viewMode": "focus"
}
